#!/usr/bin/env python3
"""Run {{ algorithm }} at scale with Hail Batch.

Generated by Bilayers (bilayers-targets: hail_batch). Do not edit by hand; regenerate
from the algorithm's config.yaml instead.

Each job runs the algorithm's Docker image ({{ image }}) on one chunk of input
files and returns that chunk's output folder as a .tar.gz. Run locally (Hail's
LocalBackend, needs Docker) or on the Hail Batch Service (Google Cloud).

Requires: pip install hail   (only the hailtop.batch part is used)

Examples:
  # local: inputs and results on this machine
  python run_batch.py --{{ chunked_input }} ./images --dst ./results

  # Hail Batch Service: inputs and results in Google Cloud Storage
  python run_batch.py --backend service --billing-project my-project \
      --remote-tmpdir gs://my-bucket/tmp/ --regions us-central1 \
      --{{ chunked_input }} gs://my-bucket/images/ --dst gs://my-bucket/results/

{{ title }}

{{ description }}
"""

import argparse
import datetime
import json
import os
import posixpath
import shlex
import sys
import tarfile
import tempfile

IMAGE = json.loads(r'''{{ image | tojson }}''')
PLATFORM = json.loads(r'''{{ platform | tojson }}''')
CLI_COMMAND = json.loads(r'''{{ cli_command | tojson }}''')
CLI_SEQUENCE = json.loads(r'''{{ cli_sequence | tojson }}''')
FILE_INPUTS = dict(json.loads(r'''{{ file_inputs | tojson }}'''))
CHUNKED_INPUT = json.loads(r'''{{ chunked_input | tojson }}''')
PARAMETERS = dict(json.loads(r'''{{ cli_parameters | tojson }}'''))
OUTPUT_DIR_PARAM = json.loads(r'''{{ output_dir_param | tojson }}''')
OUTPUT_DIR = json.loads(r'''{{ output_dir | tojson }}''')

EMPTY = (None, "", "None")


# ----------------------------------------------------------------------------- arguments


def _parse_bool(text):
    return str(text).strip().lower() in ("1", "true", "yes", "y", "on")


def build_parser():
    parser = argparse.ArgumentParser(
        description=f"Run {IMAGE} on many files with Hail Batch.",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )

    files = parser.add_argument_group("inputs and outputs")
    for name, conf in FILE_INPUTS.items():
        role = "split across jobs" if name == CHUNKED_INPUT else "given to every job"
        files.add_argument(
            f"--{name}",
            required=not conf["optional"],
            help=f"{conf['label']}: a local folder or gs:// prefix ({role}). Formats: {', '.join(conf['format']) or 'any'}.",
        )
    files.add_argument("--dst", required=True, help="Where results go: a local folder or gs:// prefix.")
    files.add_argument("--no-extract", action="store_true", help="Keep per-chunk .tar.gz files instead of unpacking them (local --dst only).")

    params = parser.add_argument_group("algorithm parameters")
    for name, conf in PARAMETERS.items():
        kwargs = {"help": conf["description"] or conf["label"]}
        default = conf["default"]
        ptype = conf["type"]
        if ptype == "checkbox":
            kwargs["type"] = _parse_bool
            kwargs["default"] = _parse_bool(default) if default not in EMPTY else False
        elif ptype in ("integer", "float"):
            # Keep the config's default as written (5, not 5.0) so the command matches the other targets.
            kwargs["type"] = int if ptype == "integer" else float
            kwargs["default"] = None if default in EMPTY else default
        else:
            kwargs["type"] = str
            kwargs["default"] = None if default in EMPTY else default
            if conf["options"]:
                kwargs["choices"] = [str(o) for o in conf["options"]]
                if conf["multiselect"]:
                    kwargs["nargs"] = "+"
        if kwargs["default"] is None and not conf["optional"]:
            kwargs["required"] = True
        params.add_argument(f"--{name}", **kwargs)

    batch = parser.add_argument_group("Hail Batch")
    batch.add_argument("--backend", choices=["local", "service"], default="local")
    batch.add_argument("--chunk-size", type=int, default=10, help="Input files per job. Each job starts one container, so larger chunks waste less time on startup.")
    batch.add_argument("--limit", type=int, default=None, help="Only process the first N input files (for trying things out).")
    batch.add_argument("--name", default=None, help="Batch name shown in Hail.")
    batch.add_argument("--dry-run", action="store_true", help="Print the jobs that would run and exit.")
    batch.add_argument("--image", default=IMAGE, help="Override the Docker image (e.g. an amd64 copy in Artifact Registry).")
    batch.add_argument("--tmp-dir", default=None, help="Local backend: scratch folder (default: system temp).")
    batch.add_argument("--billing-project", default=None, help="Service backend: Hail billing project.")
    batch.add_argument("--remote-tmpdir", default=None, help="Service backend: gs:// scratch folder.")
    batch.add_argument("--regions", default=None, help="Service backend: comma-separated regions, e.g. us-central1.")
    batch.add_argument("--cpu", default=None, help="Service backend: cores per job (power of two, 0.25-16).")
    batch.add_argument("--memory", default=None, help="Service backend: 'lowmem', 'standard', 'highmem', or e.g. '4Gi'.")
    batch.add_argument("--storage", default=None, help="Service backend: extra disk per job, e.g. '10Gi'.")
    batch.add_argument("--spot", action=argparse.BooleanOptionalAction, default=True, help="Service backend: use cheaper preemptible machines.")
    batch.add_argument("--attempts", type=int, default=None, help="Service backend: max attempts per job.")
    return parser


# ----------------------------------------------------------------------------- files


def is_cloud(path):
    return "://" in str(path)


def list_files(src, formats):
    """Files directly under a local folder or gs:// prefix, filtered by extension."""
    exts = tuple("." + f.lower().lstrip(".") for f in formats)
    if is_cloud(src):
        import hailtop.fs as hfs

        paths = [e.path for e in hfs.ls(src) if not e.is_dir()]
    else:
        src = os.path.abspath(os.path.expanduser(src))
        if not os.path.isdir(src):
            sys.exit(f"error: {src} is not a folder")
        paths = [os.path.join(src, n) for n in os.listdir(src) if os.path.isfile(os.path.join(src, n))]
    paths = [p for p in paths if not posixpath.basename(p).startswith(".")]
    if exts:
        paths = [p for p in paths if p.lower().endswith(exts)]
    return sorted(paths)


def chunk(items, size):
    return [items[i : i + size] for i in range(0, len(items), max(1, size))]


# ----------------------------------------------------------------------------- command


def option_to_append(cli_tag, value):
    """Same cli_tag forms as the other Bilayers targets: '--x v', '--x=v', or a bare value."""
    value = shlex.quote(str(value))
    if cli_tag == "":
        return value
    if cli_tag.endswith("="):
        return f"{cli_tag}{value}"
    return f"{cli_tag} {value}"


def cli_tag_is_valid(cli_tag):
    return cli_tag not in (None, "None", "")


def build_command(values):
    """Build the tool's command from the ordered cli_sequence.

    `values` maps input names to their folder inside the container and parameter
    names to the user's values. Mirrors generate_cli_command in the other targets.
    """
    parts = [CLI_COMMAND]
    for item in CLI_SEQUENCE:
        name = item.get("name", "")
        source = item.get("source", "")
        cli_tag = item.get("cli_tag", "")
        optional = item.get("optional", False)
        if source == "hidden":
            value = item.get("value", "")
        elif name == OUTPUT_DIR_PARAM:
            value = OUTPUT_DIR
        else:
            value = values.get(name, item.get("default"))

        if value in EMPTY or value == []:
            if optional or source == "hidden":
                continue
            sys.exit(f"error: {item.get('label', name)} needs a value")

        if isinstance(value, bool):
            if item.get("append_value", False):
                parts.append(option_to_append(cli_tag, value))
            elif value and cli_tag_is_valid(cli_tag):
                parts.append(cli_tag)
            continue
        if value == "ignore":
            continue
        if isinstance(value, list):
            value = " ".join(str(v) for v in value)
        if cli_tag_is_valid(cli_tag) or cli_tag == "":
            parts.append(option_to_append(cli_tag if cli_tag_is_valid(cli_tag) else "", value))
    return " ".join(parts)


# ----------------------------------------------------------------------------- batch


def make_backend(args):
    import hailtop.batch as hb

    if args.backend == "local":
        return hb.LocalBackend(tmp_dir=(args.tmp_dir or tempfile.gettempdir()).rstrip("/") + "/")
    if not args.billing_project or not args.remote_tmpdir:
        sys.exit("error: --backend service needs --billing-project and --remote-tmpdir")
    regions = args.regions.split(",") if args.regions else None
    return hb.ServiceBackend(billing_project=args.billing_project, remote_tmpdir=args.remote_tmpdir, regions=regions)


def main(argv=None):
    args = build_parser().parse_args(argv)
    if args.backend == "local" and is_cloud(args.dst):
        sys.exit("error: the local backend writes results to a local --dst")

    values = {name: getattr(args, name) for name in PARAMETERS}
    for name, conf in FILE_INPUTS.items():
        values[name] = conf["folder_name"] if getattr(args, name) else None
    command = build_command(values)

    inputs = {name: list_files(getattr(args, name), conf["format"]) for name, conf in FILE_INPUTS.items() if getattr(args, name)}
    files = inputs.get(CHUNKED_INPUT, [])
    if args.limit:
        files = files[: args.limit]
    if not files:
        sys.exit(f"error: no input files found for --{CHUNKED_INPUT}")
    chunks = chunk(files, args.chunk_size)
    shared = {name: paths for name, paths in inputs.items() if name != CHUNKED_INPUT}

    print(f"{len(files)} files in {len(chunks)} job(s) of up to {args.chunk_size}; image {args.image}")
    print(f"command: {command}")
    if args.dry_run:
        for i, c in enumerate(chunks):
            print(f"  job {i:04d}: {len(c)} files, first {posixpath.basename(c[0])}")
        return 0

    import hailtop.batch as hb

    batch = hb.Batch(backend=make_backend(args), name=args.name or f"bilayers-{posixpath.basename(IMAGE.split(':')[0])}")
    dst = args.dst.rstrip("/")
    if not is_cloud(dst):
        dst = os.path.abspath(os.path.expanduser(dst))
        os.makedirs(dst, exist_ok=True)

    tarballs = []
    for i, chunk_files in enumerate(chunks):
        job = batch.new_job(name=f"chunk-{i:04d}")
        job.image(args.image)
        if args.backend == "service":
            # Resource requests are Service-only; the LocalBackend rejects them.
            if args.cpu:
                job.cpu(args.cpu)
            if args.memory:
                job.memory(args.memory)
            if args.storage:
                job.storage(args.storage)
            if args.attempts:
                job.n_max_attempts(args.attempts)
            job.spot(args.spot)

        lines = ["set -euo pipefail"]
        for name, paths in [(CHUNKED_INPUT, chunk_files), *shared.items()]:
            folder = FILE_INPUTS[name]["folder_name"]
            lines.append(f"mkdir -p {shlex.quote(folder)}")
            for path in paths:
                resource = batch.read_input(path)
                target = posixpath.join(folder, posixpath.basename(path))
                lines.append(f"cp {resource} {shlex.quote(target)}")
        lines.append(f"mkdir -p {shlex.quote(OUTPUT_DIR)}")
        lines.append(command)
        lines.append(f"tar -czf {job.ofile} -C {shlex.quote(OUTPUT_DIR)} .")
        job.command("\n".join(lines))

        out = f"{dst}/chunk_{i:04d}.tar.gz"
        batch.write_output(job.ofile, out)
        tarballs.append(out)

    if args.backend == "service":
        batch.run(wait=True, open=False)
    else:
        batch.run()

    manifest = {
        "generated_by": "bilayers-targets hail_batch",
        "image": args.image,
        "command": command,
        "backend": args.backend,
        "finished": datetime.datetime.now().isoformat(timespec="seconds"),
        "chunks": [{"tarball": t, "inputs": [posixpath.basename(p) for p in c]} for t, c in zip(tarballs, chunks)],
    }

    if is_cloud(dst):
        import hailtop.fs as hfs

        with hfs.open(f"{dst}/run.json", "w") as f:
            f.write(json.dumps(manifest, indent=2))
        print(f"Done. {len(tarballs)} result archive(s) and run.json in {dst}/")
        return 0

    if not args.no_extract:
        manifest["extracted_to"] = dst
        for entry in manifest["chunks"]:
            entry.pop("tarball")
        for t in tarballs:
            with tarfile.open(t) as tar:
                if hasattr(tarfile, "data_filter"):
                    tar.extractall(dst, filter="data")  # refuses unsafe paths in the archive
                else:
                    tar.extractall(dst)
            os.remove(t)
    with open(os.path.join(dst, "run.json"), "w") as f:
        json.dump(manifest, f, indent=2)
    print(f"Done. Results in {dst}/")
    return 0


if __name__ == "__main__":
    sys.exit(main())
